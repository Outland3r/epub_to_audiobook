# Copy this file to .env and fill in the values. Never commit your .env file.
# OpenRouter receives the selected chapter and may charge for model usage.
OPENROUTER_API_KEY=
# Choose an OpenRouter model that supports JSON-object responses.
OPENROUTER_MODEL=provider/model

# These are for running Python on the host. The Kokoro Docker Compose setup
# supplies its own internal URL and dummy key to the converter container.
OPENAI_BASE_URL=http://localhost:8880/v1
OPENAI_API_KEY=not-needed
